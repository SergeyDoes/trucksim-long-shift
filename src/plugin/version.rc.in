// Version information shown in the DLL's file properties. Configured by CMake from the project version.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "SergeyDoes"
            VALUE "FileDescription",  "Long Shift: fatigue effects for American Truck Simulator and Euro Truck Simulator 2"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "long_shift"
            VALUE "LegalCopyright",   "Copyright (c) 2026 SergeyDoes. MIT License."
            VALUE "OriginalFilename", "long_shift.dll"
            VALUE "ProductName",      "Long Shift"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
